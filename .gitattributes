# Keep the hook LF in every working copy. `core.autocrlf` is on for at least one clone of
# this repo, and a CRLF shell script fails at its shebang with `bad interpreter: /bin/sh^M`
# — a gate that silently stops gating, which is the one failure mode a gate must not have.
.githooks/** text eol=lf

# Third-party code, kept byte-for-byte as released: no line-ending conversion, so the
# checksum in its README holds in every clone, and no diffs of 600 KB of someone else's code.
scripts/vendor/katex/katex.mjs -text -diff linguist-vendored

# The raw store, byte for byte as extracted: invariant 12 compares each file with its SHA-256
# in raw/checksums.sha256, and a clone that rewrote line endings would change every one.
raw/** -text
